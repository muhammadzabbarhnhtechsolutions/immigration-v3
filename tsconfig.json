{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "tailwind.config.js",
    "src/components/video/tabs.tsx",
    "src/components/video/videos.jsx",
    "src/components/video/index.jsx",
    "src/components/video/sidebar.jsx",
    "src/components/video/videoWithSidebar.jsx",
    "src/usable/dropdown.jsx",
    "src/usable/player.jsx",
    "src/usable/progressBarblue.jsx",
    "src/usable/progressBar.jsx",
    "src/utils/localStorage.js",
    "src/utils/constants.js",
    "src/utils/validation.js",
    "src/components/ui/DescriptionBox.jsx",
    "src/components/videos/Videos.jsx",
    "src/components/Forum/ForumCard.jsx",
    "src/components/Forum/Forum.jsx",
    "src/components/Forum/Comment.jsx",
    "src/services/getAllMeetings.js",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
